APP_NAME="Instituto DOCEO"
APP_URL=https://pdv.institutodoceo.com
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
# Clave aleatoria para cifrar secretos de proveedores (openssl rand -hex 32)
APP_KEY=

# Admin (creado/actualizado por php bin/install.php)
ADMIN_EMAIL=admin@institutodoceo.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false

# Clave para el instalador web: /setup.php?key=...
INSTALL_KEY=

DB_HOST=localhost
DB_NAME=insti241_pdv
DB_USER=insti241_manager
DB_PASS=
DB_CHARSET=utf8mb4

# Moodle — campus.institutodoceo.com
MOODLE_URL=https://campus.institutodoceo.com/webservice/rest/server.php
MOODLE_TOKEN=
MOODLE_DEFAULT_PASSWORD="Doceo*1234"

# OpenPay
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
OPENPAY_PUBLIC_KEY=
OPENPAY_SANDBOX=true
OPENPAY_API_BASE=https://sandbox-api.openpay.mx/v1
OPENPAY_BENEFICIARY_NAME="Instituto DOCEO"
# Comisión OpenPay trasladada al cliente (opcional)
OPENPAY_PASS_FEE_TO_CUSTOMER=true
OPENPAY_FEE_CARD_PERCENT=2.9
OPENPAY_FEE_CARD_FIXED=2.5
OPENPAY_FEE_SPEI_PERCENT=2.9
OPENPAY_FEE_SPEI_FIXED=0
OPENPAY_FEE_STORE_PERCENT=3.5
OPENPAY_FEE_STORE_FIXED=10
# Auth HTTP Basic del endpoint POST /webhooks/openpay (recomendado en producción)
OPENPAY_WEBHOOK_USER=
OPENPAY_WEBHOOK_PASSWORD=

# Transferencia bancaria DOCEO (fallback / comprobante manual)
BANK_TRANSFER_BANK=BBVA
BANK_TRANSFER_CLABE=
BANK_TRANSFER_HOLDER="Instituto DOCEO"

# WhatsApp de asesores (solo dígitos, con código de país)
# Por defecto: 524778775112 (Instituto DOCEO)
SCHOOL_WHATSAPP=524778775112

# Correo (Neubox: SMTP_TRANSPORT=auto)
# Bienvenida/alumnos: en auto usa mail() (no necesita SMTP AUTH).
# Solicitud a proveedor: exige SMTP (remoto AUTH o, si falla 535, MTA local :25).
# Si ves 535: restablece clave del buzón o pide a Neubox desbloquear SMTP AUTH
# (cPHulk a veces no aparece en el panel del cliente).
SMTP_HOST=mail.institutodoceo.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=certificaciones@institutodoceo.com
SMTP_TRANSPORT=auto
SMTP_PASS=
SMTP_FROM=certificaciones@institutodoceo.com
SMTP_FROM_NAME="Instituto DOCEO"
# Solo para depuración local (NUNCA en producción Neubox):
# SMTP_ALLOW_LOCALHOST=0
# Si AUTH remoto falla (535), intentar Exim local :25 sin clave (recomendado en Neubox):
SMTP_LOCAL_FALLBACK=1
MAIL_OVERRIDE_TO=

# Envia.com
ENVIA_API_KEY=
ENVIA_API_URL=https://api.envia.com
SHIPPING_FIXED_PRICE=300

# Si el CSS/logos no cargan en Neubox (docroot = raíz), descomenta:
# ASSET_BASE=/public
