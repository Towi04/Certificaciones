APP_NAME="Instituto Doceo"
APP_URL=https://pdv.institutodoceo.com
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_KEY=

ADMIN_EMAIL=admin@institutodoceo.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false

DB_HOST=localhost
DB_NAME=insti241_pdv
DB_USER=insti241_manager
DB_PASS=
DB_CHARSET=utf8mb4

MOODLE_URL=https://campus.institutodoceo.com/webservice/rest/server.php
MOODLE_TOKEN=
# Contraseña fija para altas / restablecimientos Moodle (el alumno la cambia al entrar)
MOODLE_DEFAULT_PASSWORD="Doceo*1234"
# Opcional: solo si el idioma está instalado en Moodle (omitir evita invalidparameter)
# MOODLE_USER_LANG=es_mx

OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
OPENPAY_PUBLIC_KEY=
OPENPAY_SANDBOX=true
OPENPAY_API_BASE=https://sandbox-api.openpay.mx/v1
OPENPAY_BENEFICIARY_NAME="Instituto DOCEO"
# Opcional: Basic Auth que OpenPay enviará al webhook del PDV
OPENPAY_WEBHOOK_USER=
OPENPAY_WEBHOOK_PASSWORD=

SMTP_HOST=mail.institutodoceo.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=certificaciones@institutodoceo.com
# auto = mail() local primero (recomendado en Neubox); smtp = solo AUTH; mail = solo mail()
SMTP_TRANSPORT=auto
SMTP_PASS=
SMTP_FROM=certificaciones@institutodoceo.com
SMTP_FROM_NAME="Instituto Doceo Certificaciones"
# auto | smtp | mail | log (log escribe en storage/logs/mail/ sin SMTP)
# SMTP_TRANSPORT=auto
# Fuerza To/CC de todos los correos a una bandeja de pruebas (vacío = desactivado)
MAIL_OVERRIDE_TO=
# Logo del encabezado HTML (default: https://institutodoceo.com/img/emails/logo.png)
# MAIL_LOGO_URL=https://institutodoceo.com/img/emails/logo.png
